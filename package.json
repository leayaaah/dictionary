{
  "name": "dictionary-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev:web": "pnpm --filter @dictionary/web dev",
    "build:web": "pnpm --filter @dictionary/web build",
    "lint:web": "pnpm --filter @dictionary/web lint",
    "dev:mobile": "pnpm --filter @dictionary/mobile start"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
