{
  "expo": {
    "name": "Stinary",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon_2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#153A77",
        "foregroundImage": "./assets/stinary-foreground.png",
        "monochromeImage": "./assets/stinary-monochrome.png"
      },
      "package": "com.leayaaah.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#153A77",
          "image": "./assets/stinary-foreground.png",
          "imageWidth": 192,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép truy cập ảnh để chọn ảnh đại diện.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ee015e40-8f0e-49ee-8e81-9ea75a3c722d"
      }
    }
  }
}
